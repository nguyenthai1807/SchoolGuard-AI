# Copy this file to .env and fill values only on the computer running LH25/main.py.
# Use a unique password of at least 12 characters; if left empty, LH25 generates one.
# Do not commit the real .env file.
SCHOOLGUARD_ADMIN_USER=admin
SCHOOLGUARD_ADMIN_PASSWORD=
LH25_ADMIN_PASSWORD=
LH25_TELEGRAM_BOT_TOKEN=
LH25_TELEGRAM_CHAT_ID=

# Local AI defaults. YOLO_MODEL is downloaded by Ultralytics on first use when absent.
YOLO_MODEL=yolo11n.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=640
VIDEO_FRAME_STRIDE=1
ZONE_DWELL_SECONDS=5
ZONE_ANCHOR=bottom
REDACT_PEOPLE=true
MAX_VIDEO_RESULTS=10
VIDEO_RESULT_TTL_HOURS=24

# Disabled by default because browser-only mode loads AI code from a third-party CDN.
ENABLE_BROWSER_ONLY_MODE=false
# Keep empty for the same-origin home app. Add explicit origins only for local FE development.
FRONTEND_ORIGINS=

# Gmail: use an App Password (not the normal account password).
ADMIN_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Commerce is OFF by default. Do not enable on a temporary tunnel or before
# a stable HTTPS domain, verified sending domain, payOS merchant account,
# legal/privacy review, backups and operational monitoring are ready.
LH25_PUBLIC_BASE_URL=
# Enable only after creating a Google OAuth web client and allowlisting at least one admin subject.
LH25_GOOGLE_CLIENT_ID=
LH25_GOOGLE_ADMIN_SUBS=
LH25_GOOGLE_ONLY=false
LH25_REQUIRE_VERIFIED_EMAIL=false
LH25_PAYOS_ENABLED=false
# Manual Pro transfers: fill all three with the verified receiving account.
# Leave empty until the owner has checked the bank details. Never use a test account for real customers.
LH25_MANUAL_BANK_NAME=
LH25_MANUAL_BANK_ACCOUNT=
LH25_MANUAL_BANK_RECIPIENT=
LH25_PAYOS_CLIENT_ID=
LH25_PAYOS_API_KEY=
LH25_PAYOS_CHECKSUM_KEY=

# Camera notification channel: none, email, sms, or both.
CAMERA_NOTIFY_CHANNEL=none
ADMIN_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
