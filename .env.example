# Copy this file to .env and fill the values on the computer that runs main.py.
# Gmail: use an App Password (not the normal account password).
ADMIN_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Camera notification channel: none, email, sms, or both.
CAMERA_NOTIFY_CHANNEL=none
ADMIN_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
